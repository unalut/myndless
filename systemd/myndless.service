[Unit]
Description=myndless - MYNDberry music hub (Actionslink + radio/Spotify Connect + web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myndless
Group=audio
WorkingDirectory=/opt/myndless
ExecStart=/opt/myndless/.venv/bin/python -m daemon.main
Restart=on-failure
RestartSec=2

# Environment (see daemon/config.py for the full list and defaults).
Environment=MYNDLESS_SERIAL_PORT=/dev/serial0
Environment=MYNDLESS_ALSA_CARD=default
Environment=MYNDLESS_WEB_HOST=0.0.0.0
Environment=MYNDLESS_WEB_PORT=8080

# Needs the dialout group (serial port) and audio group (ALSA/amixer).
SupplementaryGroups=dialout audio

[Install]
WantedBy=multi-user.target
